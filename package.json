{
  "name": "@johnhenry/a2a-query-tanstack",
  "version": "0.0.0",
  "description": "TanStack Query bridge for @johnhenry/a2a-query — queryOptions/mutationOptions factories that sync a2a-query's own reactive cache into TanStack Query, including task/card push updates and optimistic updates, with zero extra refetches.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/a2a-query-tanstack.git"
  },
  "homepage": "https://github.com/johnhenry/a2a-query-tanstack",
  "bugs": "https://github.com/johnhenry/a2a-query-tanstack/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "example:01": "tsx examples/01-task-and-card-query.ts",
    "example:02": "tsx examples/02-live-sync-bridge.ts",
    "example:03": "tsx examples/03-send-message-mutation.ts",
    "examples": "npm run example:01 && npm run example:02 && npm run example:03"
  },
  "peerDependencies": {
    "@johnhenry/a2a-query": "0.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@johnhenry/a2a-query": "0.0.0",
    "@johnhenry/agent-query-core": "^0.1.0-rc.4",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
