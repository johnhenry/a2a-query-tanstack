{
  "name": "@johnhenry/a2aq-tanstack",
  "version": "0.1.0",
  "description": "TanStack Query bridge for @johnhenry/a2aq — queryOptions/mutationOptions factories that sync a2aq's own reactive cache into TanStack Query, including task/card push updates and optimistic updates, with zero extra refetches.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/a2aq-tanstack.git"
  },
  "homepage": "https://github.com/johnhenry/a2aq-tanstack",
  "bugs": "https://github.com/johnhenry/a2aq-tanstack/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@johnhenry/a2aq": "0.1.0-rc.4",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@johnhenry/a2aq": "0.1.0-rc.4",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
